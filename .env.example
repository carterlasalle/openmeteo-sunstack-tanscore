# Location (defaults: Notre Dame / South Bend)
SUNSTACK_LAT=41.703293
SUNSTACK_LON=-86.238292
SUNSTACK_TZ=America/Indiana/Indianapolis

# Live forecast
SUNSTACK_FORECAST_DAYS=14
SUNSTACK_AIR_QUALITY_DAYS=7
SUNSTACK_HRRR_15MIN_STEPS=72

# Strict/full-quality mode is the default.
SUNSTACK_STRICT=1
SUNSTACK_REQUIRE_DIRECT_CAMS=1

# Outdoor opportunity rules. These do NOT change environmental TanScore.
SUNSTACK_MIN_TAN_TEMP_F=50
SUNSTACK_COMFORTABLE_TAN_TEMP_F=68
SUNSTACK_HEAT_WARNING_TEMP_F=100
SUNSTACK_MAX_TAN_TEMP_F=110
SUNSTACK_ACTIVE_PRECIP_IN_THRESHOLD=0.001
SUNSTACK_ACTIVE_SNOW_IN_THRESHOLD=0.001
SUNSTACK_PRECIP_PROBABILITY_PENALTY_MAX=0.55
SUNSTACK_WIND_WARNING_MPH=25
SUNSTACK_WIND_STRONG_MPH=35
SUNSTACK_OVERALL_ABSOLUTE_HEADROOM=20

# Historical skill window
SUNSTACK_PREVIOUS_RUNS_DAYS=1000
SUNSTACK_CAMS_EAC4_START_YEAR=2003
SUNSTACK_CAMS_EAC4_END_YEAR=2025

# UI
SUNSTACK_UI_HOST=127.0.0.1
SUNSTACK_UI_PORT=8765

# Copernicus ADS: prefer standard ~/.cdsapirc.
# Or set these if your cdsapi installation supports environment credentials:
# CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
# CDSAPI_KEY=<your key>

# BEGIN BUGHUNT MANAGED ENV CONTRACT
# Generated from static environment-variable use. Never contains real secrets.
# REQUIRED | type: str | source: src/sunstack/history.py:312
CDSAPI_KEY=
# REQUIRED | type: str | source: src/sunstack/history.py:320
CDSAPI_URL=
# OPTIONAL | type: int | default: '1800' | unit: seconds | example: '1800' | source: src/sunstack/config.py:53
SUNSTACK_CAMS_TIMEOUT_S=1800
# OPTIONAL | type: int | default: '3' | example: '3' | source: src/sunstack/config.py:54
SUNSTACK_CAMS_WORKERS=3
# OPTIONAL | type: float | default: '180' | example: '180' | source: src/sunstack/config.py:25
SUNSTACK_SKIN_AZIMUTH_DEG=180
# OPTIONAL | type: float | default: '0' | example: '0' | source: src/sunstack/config.py:24
SUNSTACK_SKIN_TILT_DEG=0
# END BUGHUNT MANAGED ENV CONTRACT
